{
  "info": {
    "_postman_id": "c5c2c1c8-ongoing-auctions-slim-001",
    "name": "Ongoing Auctions (Slim)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Slim response version returning only card fields for ongoing (active) auctions."
  },
  "item": [
    {
      "name": "Get Ongoing Auctions (Slim)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ]
        },
        "description": "Returns slim cards: auction_id, title, main_image, remaining_time{}, bids_count, current_price, seller_avatar."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions (By Category)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?category_id={{CATEGORY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [ { "key": "category_id", "value": "{{CATEGORY_ID}}" } ]
        },
        "description": "Filter slim ongoing auctions by category_id."
      },
      "response": []
    },
    {
      "name": "Get Live Auctions (Slim)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/live",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "live" ]
        },
        "description": "Returns the same data as active (alias endpoint)."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions (By Country)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [ { "key": "country_id", "value": "{{COUNTRY_ID}}" } ]
        },
        "description": "Filter slim ongoing auctions by country_id."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions (By Category & Country)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?category_id={{CATEGORY_ID}}&country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [
            { "key": "category_id", "value": "{{CATEGORY_ID}}" },
            { "key": "country_id", "value": "{{COUNTRY_ID}}" }
          ]
        },
        "description": "Filter slim ongoing auctions by both category_id and country_id."
      },
      "response": []
    }
  ],
  "variable": [
