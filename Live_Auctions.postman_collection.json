{
  "info": {
    "_postman_id": "f1d5a2b4-live-auctions-001",
    "name": "Live Auctions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for Live Auctions endpoint (alias of active auctions)."
  },
  "item": [
    {
      "name": "Get Live Auctions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/live",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "live" ]
        },
        "description": "Returns all live (active) auctions in slim format."
      },
      "response": []
    },
    {
      "name": "Get Live Auctions By Category",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/live?category_id={{CATEGORY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "live" ],
          "query": [ { "key": "category_id", "value": "{{CATEGORY_ID}}" } ]
        },
        "description": "Filter live auctions by category_id."
      },
      "response": []
    },
    {
      "name": "Get Live Auctions By Country",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/live?country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "live" ],
          "query": [ { "key": "country_id", "value": "{{COUNTRY_ID}}" } ]
        },
        "description": "Filter live auctions by country_id."
      },
      "response": []
    },
    {
      "name": "Get Live Auctions By Category & Country",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/live?category_id={{CATEGORY_ID}}&country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "live" ],
          "query": [
            { "key": "category_id", "value": "{{CATEGORY_ID}}" },
            { "key": "country_id", "value": "{{COUNTRY_ID}}" }
          ]
        },
        "description": "Filter live auctions by both category_id and country_id."
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "https://testsites.azsystems.tech" },
    { "key": "JWT_TOKEN", "value": "" },
    { "key": "CATEGORY_ID", "value": "1" },
    { "key": "COUNTRY_ID", "value": "1" }
  ]
}
