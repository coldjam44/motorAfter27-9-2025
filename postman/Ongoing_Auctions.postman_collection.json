{
  "info": {
    "_postman_id": "b4de6b2f-4d9d-4f2e-9a6d-ongoing-auctions-001",
    "name": "Ongoing Auctions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection to fetch currently active (ongoing) auctions with optional filters."
  },
  "item": [
    {
      "name": "Get Ongoing Auctions (All)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{JWT_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "api",
            "auctions",
            "active"
          ]
        },
        "description": "Fetch all active auctions. Returns array of auction objects with ad details and remaining_time."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions By Category",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?category_id={{CATEGORY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [
            { "key": "category_id", "value": "{{CATEGORY_ID}}", "description": "Filter by category ID" }
          ]
        },
        "description": "Filter active auctions by category."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions By Country",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [
            { "key": "country_id", "value": "{{COUNTRY_ID}}", "description": "Filter by country ID" }
          ]
        },
        "description": "Filter active auctions by country."
      },
      "response": []
    },
    {
      "name": "Get Ongoing Auctions By Category & Country",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/auctions/active?category_id={{CATEGORY_ID}}&country_id={{COUNTRY_ID}}",
          "host": [ "{{BASE_URL}}" ],
          "path": [ "api", "auctions", "active" ],
          "query": [
            { "key": "category_id", "value": "{{CATEGORY_ID}}" },
            { "key": "country_id", "value": "{{COUNTRY_ID}}" }
          ]
        },
        "description": "Filter active auctions by both category and country."
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "https://testsites.azsystems.tech" },
    { "key": "JWT_TOKEN", "value": "" },
    { "key": "CATEGORY_ID", "value": "1" },
    { "key": "COUNTRY_ID", "value": "1" }
  ]
}
