				{
					"name": "Get Active Auctions",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has auctions array', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('auctions');",
									"    pm.expect(jsonData.auctions).to.be.an('array');",
									"});",
									"",
									"// Log number of active auctions",
									"const responseJson = pm.response.json();",
									"console.log('Number of active auctions:', responseJson.auctions.length);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auctions/active?category_id=1&country_id=13",
							"host": [
								"{{base_url}}"
							],
