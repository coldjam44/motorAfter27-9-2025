				{
					"name": "Create Auction",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Check if JWT Token exists",
									"const token = pm.environment.get('jwt_token');",
									"if (!token) {",
									"    console.warn('⚠️ JWT Token not found. Please run Login first.');",
									"} else {",
									"    console.log('✅ JWT Token found, proceeding with request');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test auction creation",
									"pm.test('Status code is 201 (Created)', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains auction data', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('ad_id');",
									"    pm.expect(jsonData).to.have.property('auction_id');",
									"    pm.expect(jsonData).to.have.property('ad_data');",
									"    pm.expect(jsonData).to.have.property('auction_data');",
									"});",
									"",
									"// Save auction ID for later use",
									"if (pm.response.code === 201) {",
									"    const responseJson = pm.response.json();",
									"    pm.environment.set('auction_id', responseJson.auction_id);",
									"    pm.environment.set('ad_id', responseJson.ad_id);",
									"    console.log('✅ Auction created successfully!');",
									"    console.log('Auction ID:', responseJson.auction_id);",
									"    console.log('Ad ID:', responseJson.ad_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
