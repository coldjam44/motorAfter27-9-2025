								{
									"key": "country_id",
									"value": "13",
									"description": "فلترة حسب الدولة (اختياري)"
								}
							]
						},
						"description": "عرض جميع المزادات النشطة حالياً\n\n**لا يحتاج تسجيل دخول**\n\nيمكن فلترة النتائج حسب:\n- category_id: التصنيف\n- country_id: الدولة"
					},
					"response": []
				},
				{
					"name": "Get Auction Details",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has auction details', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('auction');",
									"    pm.expect(jsonData).to.have.property('remaining_time');",
									"    pm.expect(jsonData).to.have.property('is_active');",
									"});",
									"",
									"// Log auction status",
									"const responseJson = pm.response.json();",
									"console.log('Auction Status:', responseJson.is_active ? 'Active' : 'Inactive');",
									"if (responseJson.remaining_time && !responseJson.remaining_time.expired) {",
									"    console.log('Time remaining:', responseJson.remaining_time.days + ' days, ' + responseJson.remaining_time.hours + ' hours');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
