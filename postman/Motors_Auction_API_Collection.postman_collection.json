				{
					"name": "Place Bid",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Check if JWT Token exists",
									"const token = pm.environment.get('jwt_token');",
									"if (!token) {",
									"    console.warn('⚠️ JWT Token not found. Please run Login first.');",
									"}",
									"",
									"// Check if auction_id exists",
									"const auctionId = pm.environment.get('auction_id');",
									"if (!auctionId) {",
									"    console.warn('⚠️ Auction ID not found. Please create an auction first.');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Bid placed successfully', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains bid data', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('bid');",
									"    pm.expect(jsonData).to.have.property('new_current_price');",
									"});",
									"",
									"// Log new current price",
									"if (pm.response.code === 201) {",
									"    const responseJson = pm.response.json();",
									"    console.log('✅ Bid placed successfully!');",
									"    console.log('New current price:', responseJson.new_current_price);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"bid_amount\": 1900\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auctions/{{auction_id}}/bid",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auctions",
								"{{auction_id}}",
								"bid"
							]
						},
						"description": "وضع مزايدة جديدة على المزاد\n\n**المطلوب:**\n- JWT Token (تسجيل دخول)\n- auction_id (من إنشاء المزاد)\n- bid_amount (يجب أن يكون أكبر من السعر الحالي + bid_increment)\n\n**قيود:**\n- لا يمكن المزايدة على مزادك الخاص\n- يجب أن يكون المزاد نشطاً\n- المبلغ يجب أن يحترم الحد الأدنى للزيادة"
					},
					"response": []
