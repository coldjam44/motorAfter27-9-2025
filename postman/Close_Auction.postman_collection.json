{
  "info": {
    "_postman_id": "close-auction-2025",
    "name": "Close Auction",
    "description": "Close an auction by setting its status to 'ended' (manual close)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Close Auction",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auctions/{{auction_id}}/close",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "auctions", "{{auction_id}}", "close" ]
        },
        "description": "Closes the auction with the given ID. Requires authentication."
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://motors.azsystems.tech" },
    { "key": "jwt_token", "value": "" },
    { "key": "auction_id", "value": "1" }
  ]
}
