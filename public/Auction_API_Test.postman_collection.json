		{
			"name": "Activate Auction",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// تأكد من وجود JWT Token",
							"console.log('JWT Token:', pm.environment.get('jwt_token'));",
							"console.log('Auction ID:', pm.environment.get('auction_id'));"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response indicates success', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status', true);",
							"    pm.expect(jsonData).to.have.property('message');",
							"    pm.expect(jsonData).to.have.property('auction');",
							"});",
							"",
							"pm.test('Auction status is active', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.auction) {",
							"        pm.expect(jsonData.auction.status).to.eql('active');",
							"    }",
							"});",
							"",
							"// عرض تفاصيل المزاد المفعل",
							"if (pm.response.code === 200) {",
							"    const responseJson = pm.response.json();",
							"    console.log('تم تفعيل المزاد:', responseJson);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
