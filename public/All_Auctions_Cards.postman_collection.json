{
	"info": {
		"_postman_id": "all-auctions-cards-2025",
		"name": "All Auctions Cards - Motors App",
		"description": "Collection for retrieving all auctions with basic card information (not just active ones)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Auctions (Basic Cards)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has success and auctions fields', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson).to.have.property('success', true);",
							"    pm.expect(responseJson).to.have.property('auctions');",
							"    pm.expect(responseJson).to.have.property('total_count');",
							"    pm.expect(responseJson.auctions).to.be.an('array');",
							"});",
							"",
							"pm.test('Each auction has basic card information', function () {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.auctions.length > 0) {",
							"        const auction = responseJson.auctions[0];",
							"        pm.expect(auction).to.have.property('auction_id');",
							"        pm.expect(auction).to.have.property('ad_id');",
							"        pm.expect(auction).to.have.property('title');",
							"        pm.expect(auction).to.have.property('description');",
							"        pm.expect(auction).to.have.property('main_image_url');",
							"        pm.expect(auction).to.have.property('current_price');",
							"        pm.expect(auction).to.have.property('starting_price');",
							"        pm.expect(auction).to.have.property('total_bids');",
							"        pm.expect(auction).to.have.property('category');",
							"        pm.expect(auction).to.have.property('location');",
							"        pm.expect(auction).to.have.property('seller');",
							"        pm.expect(auction).to.have.property('status');",
							"        pm.expect(auction).to.have.property('timing');",
							"    }",
							"});",
							"",
							"pm.test('Auction status contains required fields', function () {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.auctions.length > 0) {",
							"        const status = responseJson.auctions[0].status;",
							"        pm.expect(status).to.have.property('auction_status');",
							"        pm.expect(status).to.have.property('is_active');",
							"        pm.expect(status).to.have.property('is_expired');",
							"        pm.expect(status).to.have.property('is_upcoming');",
							"    }",
							"});",
							"",
							"console.log('✅ All auctions retrieved successfully');",
							"console.log('Total auctions found:', pm.response.json().total_count);",
							"",
							"// Display auction statuses",
							"const auctions = pm.response.json().auctions;",
							"const statusCounts = {};",
							"auctions.forEach(auction => {",
							"    const status = auction.status.auction_status;",
							"    statusCounts[status] = (statusCounts[status] || 0) + 1;",
							"});",
							"console.log('Auction statuses:', statusCounts);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions"]
				},
				"description": "Get all auctions (pending, active, expired) with basic card information including title, description, images, pricing, bids count, seller info, and status"
			},
			"response": []
		},
