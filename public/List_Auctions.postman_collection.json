{
	"info": {
		"_postman_id": "list-auctions-2025",
		"name": "List Auctions - Motors App",
		"description": "Collection for listing active auctions with filtering options",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Active Auctions",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has auctions array', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson).to.have.property('auctions');",
							"    pm.expect(responseJson.auctions).to.be.an('array');",
							"});",
							"",
							"pm.test('Each auction has required fields', function () {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.auctions.length > 0) {",
							"        const auction = responseJson.auctions[0];",
							"        pm.expect(auction).to.have.property('auction_data');",
							"        pm.expect(auction).to.have.property('ad_data');",
							"        pm.expect(auction).to.have.property('remaining_time');",
							"        ",
							"        // Check ad data structure",
							"        const adData = auction.ad_data;",
							"        pm.expect(adData).to.have.property('id');",
							"        pm.expect(adData).to.have.property('title');",
							"        pm.expect(adData).to.have.property('description');",
							"        pm.expect(adData).to.have.property('main_image_url');",
							"        pm.expect(adData).to.have.property('sub_images_urls');",
							"    }",
							"});",
							"",
							"console.log('✅ Active auctions retrieved successfully');",
							"console.log('Total auctions found:', pm.response.json().auctions.length);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/active",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "active"]
				},
				"description": "Get all active auctions that are currently running"
			},
			"response": []
		},
		{
			"name": "Get Active Auctions by Category",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Filtered auctions belong to specified category', function () {",
							"    const responseJson = pm.response.json();",
							"    const categoryId = pm.request.url.query.get('category_id');",
							"    ",
							"    if (responseJson.auctions.length > 0 && categoryId) {",
							"        responseJson.auctions.forEach(auction => {",
							"            pm.expect(auction.ad_data.category.id.toString()).to.equal(categoryId);",
							"        });",
							"    }",
							"});",
							"",
							"console.log('✅ Category filtered auctions retrieved successfully');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/active?category_id=1",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "active"],
					"query": [
						{
							"key": "category_id",
							"value": "1",
							"description": "Filter by category ID (Cars = 1)"
						}
					]
				},
				"description": "Get active auctions filtered by category (e.g., Cars category)"
			},
			"response": []
		},
