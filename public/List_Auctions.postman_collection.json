		{
			"name": "Get Active Auctions with Multiple Filters",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Filtered auctions match both category and country', function () {",
							"    const responseJson = pm.response.json();",
							"    const categoryId = pm.request.url.query.get('category_id');",
							"    const countryId = pm.request.url.query.get('country_id');",
							"    ",
							"    if (responseJson.auctions.length > 0) {",
							"        responseJson.auctions.forEach(auction => {",
							"            if (categoryId) {",
							"                pm.expect(auction.ad_data.category.id.toString()).to.equal(categoryId);",
							"            }",
							"            if (countryId) {",
							"                pm.expect(auction.ad_data.country.id.toString()).to.equal(countryId);",
							"            }",
							"        });",
							"    }",
							"});",
							"",
							"console.log('✅ Multi-filtered auctions retrieved successfully');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/active?category_id=1&country_id=13",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "active"],
					"query": [
						{
							"key": "category_id",
							"value": "1",
							"description": "Filter by category ID (Cars = 1)"
						},
						{
							"key": "country_id",
							"value": "13",
							"description": "Filter by country ID (Egypt = 13)"
						}
					]
				},
				"description": "Get active auctions filtered by both category and country"
			},
			"response": []
		},
