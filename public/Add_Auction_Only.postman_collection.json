	"item": [
		{
			"name": "Create Auction",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Auction created successfully', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"if (pm.response.code === 201) {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.auction_id) {",
							"        pm.environment.set('auction_id', responseJson.auction_id);",
							"        pm.environment.set('ad_id', responseJson.ad_id);",
							"        console.log('✅ Auction created successfully');",
							"        console.log('Auction ID:', responseJson.auction_id);",
							"        console.log('Ad ID:', responseJson.ad_id);",
							"    }",
							"} else {",
							"    console.log('❌ Auction creation failed');",
							"    console.log('Status:', pm.response.code);",
							"    console.log('Response:', pm.response.text());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
