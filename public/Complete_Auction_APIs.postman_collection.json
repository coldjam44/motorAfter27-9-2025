		{
			"name": "3. Activate Auction",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Auction activated successfully', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.be.true;",
							"    pm.expect(jsonData.auction.status).to.eql('active');",
							"});",
							"",
							"console.log('Auction activated:', pm.response.json());"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/{{auction_id}}/activate",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "{{auction_id}}", "activate"]
				},
				"description": "تفعيل المزاد من pending إلى active"
			}
		},
		{
			"name": "4. Get Active Auctions",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/active",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "active"]
				},
				"description": "جلب جميع المزادات النشطة"
			}
		},
		{
			"name": "5. Get Auction Details",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auctions/{{auction_id}}",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "{{auction_id}}"]
				},
				"description": "جلب تفاصيل مزاد محدد"
			}
		},
		{
			"name": "6. Place Bid",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Bid placed successfully', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"if (pm.response.code === 201) {",
							"    const responseJson = pm.response.json();",
							"    console.log('Bid placed:', responseJson);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "json",
					"raw": "{\n    \"bid_amount\": 1900\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auctions/{{auction_id}}/bid",
					"host": ["{{base_url}}"],
					"path": ["api", "auctions", "{{auction_id}}", "bid"]
				},
				"description": "وضع مزايدة على المزاد"
			}
		}
	],
