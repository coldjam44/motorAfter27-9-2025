{
	"info": {
		"_postman_id": "complete-auction-apis-2025",
		"name": "Complete Auction APIs Collection",
		"description": "مجموعة كاملة لجميع APIs المزادات - Motors App",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
